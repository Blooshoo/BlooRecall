#!/usr/bin/env bash
# BlooRecall MCP stdio server. Register this path as an MCP stdio server in your
# agent/client (see the README for Claude Code and mcpServers examples).
# stdout is the MCP transport, so nothing here may print to stdout.
set -euo pipefail
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# -P: never import from the caller's working directory. `python3 -m` otherwise puts it ahead
# of PYTHONPATH, so any folder holding a bloorecall/ package (another checkout, or a planted
# one) would run instead of this install.
export PYTHONPATH="${PROJECT_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -P -m bloorecall.mcp_server
